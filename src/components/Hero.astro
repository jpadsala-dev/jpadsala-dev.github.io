---
import Icon from './Icon.astro';
import { profile, releaseCard as rc, skillRail } from '../data/profile';

---

<section class="hero" aria-labelledby="hero-title">
  <!-- Decorative looping background (source: motion/hero-bg). Started by script below unless reduced motion is on. -->
  <video
    class="hero-bg"
    muted
    loop
    playsinline
    preload="metadata"
    poster="/media/hero-bg-poster.jpg"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/media/hero-bg.webm" type="video/webm" />
    <source src="/media/hero-bg.mp4" type="video/mp4" />
  </video>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="label-md where">{profile.role} · {profile.location}</p>
      <h1 id="hero-title" class="display-lg">{profile.name}</h1>
      <p class="tagline">Flutter apps, shipped to both stores.</p>
      <p class="body-md lead">{profile.intro}</p>
      <div class="ctas">
        <a class="btn btn-forest" href="#experience">See my experience <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn-glass" href={profile.resume} download><Icon name="download" size={18} /> Download resume</a>
      </div>
    </div>

    <aside class="card" aria-label="At a glance">
      <div class="row">
        <div>
          <span class="row-label">Platforms</span>
          <span class="row-value">{rc.platforms}</span>
        </div>
        <span class="chip">One codebase</span>
      </div>

      <p class="rate">Dart &amp; Flutter · {rc.experience} in production</p>

      <div class="row field">
        <div>
          <span class="row-label">Apps released</span>
          <span class="row-num">{rc.appsReleased}</span>
        </div>
        <span class="row-note">{rc.appsReleasedNote}</span>
      </div>

      <div class="banner">
        <span class="tick"><Icon name="check" size={16} /></span>
        <span><strong>{rc.crashFree}</strong> {rc.crashFreeNote}</span>
      </div>

      <div class="row field">
        <div>
          <span class="row-label">Release pipeline</span>
          <span class="row-value">Signing → TestFlight → Store review</span>
        </div>
      </div>

      <a class="btn btn-forest send" href="#contact">Get in touch <Icon name="arrow-right" size={18} /></a>
    </aside>
  </div>

  <div class="rail-wrap">
    <div class="rail-track">
      <ul class="rail" aria-label="Tools I work with">
        {skillRail.map((s) => <li>{s}</li>)}
      </ul>
      <!-- duplicate set makes the loop seamless; hidden from assistive tech -->
      <ul class="rail rail-dup" aria-hidden="true">
        {skillRail.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  // Play the background loop only when the visitor hasn't asked for reduced motion;
  // otherwise the poster frame stays as a still background.
  const video = document.querySelector<HTMLVideoElement>('.hero-bg');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const sync = () => {
    if (!video) return;
    if (reduce.matches) video.pause();
    else video.play().catch(() => {});
  };
  sync();
  reduce.addEventListener('change', sync);
</script>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--hero-bg); color: var(--hero-ink);
    padding-top: var(--nav-h); /* room for the floating header, which the video runs behind */
    padding-bottom: 28px;
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    width: 100%; height: 100%;
    object-fit: cover; object-position: 70% 50%;
    pointer-events: none;
  }
  .hero-grid {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--gap) clamp(40px, 6vw, 96px);
    padding-block: clamp(48px, 7vw, 96px) clamp(48px, 6vw, 72px);
  }
  .hero-copy { flex: 999 1 520px; min-width: 0; }
  .where { margin: 0 0 20px; color: var(--hero-ink-soft); }
  .tagline {
    margin: 24px 0 0; font-size: clamp(22px, 2.4vw, 30px); font-weight: 600;
    line-height: 1.2; letter-spacing: -0.01em;
  }
  .lead { margin: 16px 0 0; max-width: 540px; color: var(--hero-ink-soft); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  /* calculator-style panel: flat, white, inset-hairline rows */
  .card {
    flex: 1 1 360px; max-width: 480px; min-width: 0;
    background: var(--card-bg); color: var(--text-primary);
    padding: 24px; display: flex; flex-direction: column; gap: 12px;
  }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 16px; }
  .row > div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .field { box-shadow: var(--hairline-inset); border-radius: var(--r-hairline); }
  .row-label { font-size: 14px; color: var(--text-tertiary); }
  .row-value { font-weight: 600; font-size: 18px; }
  .row-num { font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: 48px; line-height: 0.9; }
  .row-note { font-size: 14px; color: var(--text-secondary); text-align: right; max-width: 170px; }
  .chip { background: var(--glass); border-radius: var(--r-control); padding: 8px 14px; font-size: 14px; font-weight: 600; white-space: nowrap; }
  .rate { margin: 0; align-self: flex-start; padding: 6px 12px; border-radius: var(--r-control); background: var(--surface-muted); font-size: 14px; font-weight: 600; }
  .banner {
    display: flex; gap: 10px; align-items: flex-start; padding: 12px 16px;
    background: var(--surface-hero); color: var(--surface-forest); font-size: 15px;
  }
  .tick { display: inline-flex; padding: 3px; border-radius: 50%; background: var(--surface-forest); color: var(--accent-lime); margin-top: 1px; }
  .send { width: 100%; margin-top: 8px; }

  /* Continuous marquee: two identical sets slide left by exactly one set's width, then loop. */
  .rail-wrap {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .rail-track {
    display: flex; width: max-content;
    animation: rail-scroll 45s linear infinite;
  }
  .rail-wrap:hover .rail-track,
  .rail-wrap:focus-within .rail-track { animation-play-state: paused; }
  /* Trailing padding equals the gap so the seam between the two sets matches the chip spacing. */
  .rail {
    display: flex; gap: 10px; margin: 0; list-style: none;
    padding: 4px 10px 4px 0;
  }
  @keyframes rail-scroll {
    to { transform: translateX(-50%); }
  }

  /* No motion requested: fall back to the static, swipeable rail. */
  @media (prefers-reduced-motion: reduce) {
    .rail-wrap { overflow-x: auto; scrollbar-width: none; -webkit-mask-image: none; mask-image: none; }
    .rail-wrap::-webkit-scrollbar { display: none; }
    .rail-track { animation: none; min-width: 100%; }
    .rail { padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
    .rail-dup { display: none; }
  }
  .rail li {
    border-radius: var(--r-control); padding: 10px 18px;
    background: var(--hero-chip-bg); font-weight: 600; font-size: 15px; white-space: nowrap;
  }

  @media (max-width: 480px) {
    .card { padding: 16px; }
    .row-note { display: none; }
  }
</style>
