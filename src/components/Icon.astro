---
interface Props {
  name: 'check' | 'arrow-right' | 'arrow-up-right' | 'download' | 'mail';
  size?: number;
  label?: string;
}
const { name, size = 20, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17L17 7M8 7h9v9" />}
  {name === 'download' && <path d="M12 4v11m-5-5l5 5 5-5M5 20h14" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></>}
</svg>
